# Copy this file to .env and replace every required blank value before using Docker Compose.
# Never commit .env. Generate independent random values for every signing/encryption secret.
# Authoritative formats, ownership, rotation, and recovery:
# docs/deployment/production-secrets.md

AGENT_DESK_MYSQL_DATABASE=cs_ai_agent
AGENT_DESK_MYSQL_USER=cs_ai_agent
AGENT_DESK_MYSQL_PASSWORD=
AGENT_DESK_MYSQL_ROOT_PASSWORD=
AGENT_DESK_DB_DSN=

# Fresh-database bootstrap only. Keep the password in the deployment secret
# file, never in YAML, source code, screenshots, logs, or handoff documents.
AGENT_DESK_BOOTSTRAP_ADMIN_USERNAME=
AGENT_DESK_BOOTSTRAP_ADMIN_PASSWORD=

# Keep true for the active service. Set false only on isolated migration,
# restore-rehearsal, or read-only preflight instances.
AGENT_DESK_BACKGROUND_WORKERS_ENABLED=true

# Independent Base64-encoded 32-byte keys. Never rotate the Store credential
# master key without an explicit re-encryption migration.
AGENT_DESK_INVITATION_ENCRYPTION_KEY=
AGENT_DESK_STORE_MODEL_CREDENTIAL_MASTER_KEY=
AGENT_DESK_STORE_MODEL_CREDENTIAL_MASTER_KEY_ID=

# Independent secrets with at least 32 bytes.
AGENT_DESK_CUSTOMER_SESSION_SECRET=
AGENT_DESK_ASSET_URL_SIGNING_SECRET=

# Enable FastGPT for the unified AI runtime and supply its platform integration
# token. This is not a Store NewAPI key; Store keys only enter through the
# credential UI/API and never belong in this file.
AGENT_DESK_FASTGPT_ENABLED=false
AGENT_DESK_FASTGPT_BASE_URL=
AGENT_DESK_FASTGPT_INTEGRATION_TOKEN=
AGENT_DESK_FASTGPT_RETRIEVAL_TOKEN_LIMIT=400

# Optional integrations. Their secret values are environment-only when enabled.
AGENT_DESK_EMAIL_ENABLED=false
AGENT_DESK_EMAIL_HOST=
AGENT_DESK_EMAIL_USERNAME=
AGENT_DESK_EMAIL_PASSWORD=
AGENT_DESK_EMAIL_FROM=
AGENT_DESK_EMAIL_PUBLIC_URL=
AGENT_DESK_OIDC_ENABLED=false
AGENT_DESK_OIDC_ISSUER=
AGENT_DESK_OIDC_CLIENT_ID=
AGENT_DESK_OIDC_CLIENT_SECRET=
AGENT_DESK_OIDC_REDIRECT_URL=
AGENT_DESK_OIDC_STATE_SECRET=
AGENT_DESK_OSS_ACCESS_KEY_ID=
AGENT_DESK_OSS_ACCESS_KEY_SECRET=
AGENT_DESK_WXWORK_ENABLED=false
AGENT_DESK_WXWORK_CORP_ID=
AGENT_DESK_WXWORK_CORP_SECRET=
AGENT_DESK_WXWORK_AGENT_ID=
AGENT_DESK_WXWORK_OAUTH_REDIRECT=
AGENT_DESK_WXWORK_STATE_SECRET=
AGENT_DESK_WXWORK_RSA_PRIVATE_KEY=
AGENT_DESK_WXWORK_TOKEN=
AGENT_DESK_WXWORK_ENCODING_AES_KEY=

# Hotel mini-program arrival linking and WeCom provider authorization.
# Keep disabled until the official provider callbacks, HTTPS domain, and
# mini-program request domain are configured. All secret values remain blank.
AGENT_DESK_ARRIVAL_ENABLED=false
AGENT_DESK_ARRIVAL_PUBLIC_BASE_URL=
AGENT_DESK_MINIPROGRAM_APP_ID=
AGENT_DESK_MINIPROGRAM_APP_SECRET=
AGENT_DESK_ARRIVAL_SESSION_SECRET=
AGENT_DESK_ARRIVAL_IDENTITY_HMAC_KEY=
AGENT_DESK_ARRIVAL_DATA_MASTER_KEY=
AGENT_DESK_ARRIVAL_DATA_MASTER_KEY_ID=
AGENT_DESK_WECOM_SUITE_ID=
AGENT_DESK_WECOM_SUITE_SECRET=
AGENT_DESK_WECOM_PROVIDER_CALLBACK_TOKEN=
AGENT_DESK_WECOM_PROVIDER_ENCODING_AES_KEY=
# Installation testing uses 1. Change to 0 only after formal publication.
AGENT_DESK_WECOM_AUTH_TYPE=1
AGENT_DESK_ARRIVAL_WECHAT_API_BASE_URL=https://api.weixin.qq.com
AGENT_DESK_ARRIVAL_WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
AGENT_DESK_ARRIVAL_QR_ALLOWED_HOST_SUFFIXES=wework.qpic.cn,wwcdn.weixin.qq.com,work.weixin.qq.com
AGENT_DESK_ARRIVAL_SESSION_TTL_MINUTES=30
AGENT_DESK_ARRIVAL_INVITATION_TTL_MINUTES=1440
AGENT_DESK_ARRIVAL_CONTACT_WAY_TTL_MINUTES=1440
AGENT_DESK_ARRIVAL_DELIVERY_RATE_LIMIT_SECONDS=60

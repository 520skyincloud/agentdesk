# Copy this file to .env and replace every required blank value before using Docker Compose.
# Never commit .env. Generate independent random values for every signing/encryption secret.

AGENT_DESK_MYSQL_DATABASE=cs_ai_agent
AGENT_DESK_MYSQL_USER=cs_ai_agent
AGENT_DESK_MYSQL_PASSWORD=
AGENT_DESK_MYSQL_ROOT_PASSWORD=
AGENT_DESK_DB_DSN=

# Keep true for the active service. Set false only on isolated migration,
# restore-rehearsal, or read-only preflight instances.
AGENT_DESK_BACKGROUND_WORKERS_ENABLED=true

# Base64-encoded 32-byte keys.
AGENT_DESK_INVITATION_ENCRYPTION_KEY=
AGENT_DESK_STORE_MODEL_CREDENTIAL_MASTER_KEY=
AGENT_DESK_STORE_MODEL_CREDENTIAL_MASTER_KEY_ID=

# Independent secrets with at least 32 bytes.
AGENT_DESK_CUSTOMER_SESSION_SECRET=
AGENT_DESK_ASSET_URL_SIGNING_SECRET=

# Enable FastGPT for the unified AI runtime and supply the managed integration token.
AGENT_DESK_FASTGPT_ENABLED=false
AGENT_DESK_FASTGPT_BASE_URL=
AGENT_DESK_FASTGPT_INTEGRATION_TOKEN=
AGENT_DESK_FASTGPT_RETRIEVAL_TOKEN_LIMIT=400

# Optional integrations. Their secret values are environment-only when enabled.
AGENT_DESK_EMAIL_ENABLED=false
AGENT_DESK_EMAIL_HOST=
AGENT_DESK_EMAIL_USERNAME=
AGENT_DESK_EMAIL_PASSWORD=
AGENT_DESK_EMAIL_FROM=
AGENT_DESK_EMAIL_PUBLIC_URL=
AGENT_DESK_OIDC_ENABLED=false
AGENT_DESK_OIDC_ISSUER=
AGENT_DESK_OIDC_CLIENT_ID=
AGENT_DESK_OIDC_CLIENT_SECRET=
AGENT_DESK_OIDC_REDIRECT_URL=
AGENT_DESK_OIDC_STATE_SECRET=
AGENT_DESK_OSS_ACCESS_KEY_ID=
AGENT_DESK_OSS_ACCESS_KEY_SECRET=
AGENT_DESK_WXWORK_ENABLED=false
AGENT_DESK_WXWORK_CORP_ID=
AGENT_DESK_WXWORK_CORP_SECRET=
AGENT_DESK_WXWORK_AGENT_ID=
AGENT_DESK_WXWORK_OAUTH_REDIRECT=
AGENT_DESK_WXWORK_STATE_SECRET=
AGENT_DESK_WXWORK_RSA_PRIVATE_KEY=
AGENT_DESK_WXWORK_TOKEN=
AGENT_DESK_WXWORK_ENCODING_AES_KEY=

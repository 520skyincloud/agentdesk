{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/handoff_pending_action.v2.json",
  "title": "HandoffPendingActionV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffToken",
    "tenantId",
    "storeId",
    "storeStaffBindingId",
    "protocolInstanceId",
    "conversationId",
    "sessionNo",
    "turnId",
    "turnVersion",
    "taskKeys",
    "originMessageId",
    "requestId",
    "originType",
    "mode",
    "reasonCode",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "handoff_pending_action.v2"
    },
    "handoffToken": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "tenantId": {
      "type": "integer",
      "minimum": 1
    },
    "storeId": {
      "type": "integer",
      "minimum": 1
    },
    "storeStaffBindingId": {
      "type": "integer",
      "minimum": 1
    },
    "protocolInstanceId": {
      "type": "integer",
      "minimum": 1
    },
    "conversationId": {
      "type": "integer",
      "minimum": 1
    },
    "sessionNo": {
      "type": "integer",
      "minimum": 1
    },
    "turnId": {
      "type": "integer",
      "minimum": 1
    },
    "turnVersion": {
      "type": "integer",
      "minimum": 1
    },
    "taskKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "originMessageId": {
      "type": "integer",
      "minimum": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "originType": {
      "enum": [
        "business_handoff",
        "safety_handoff"
      ]
    },
    "mode": {
      "enum": [
        "confirm",
        "dispatch"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
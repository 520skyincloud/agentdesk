{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/reply_output.v2.json",
  "title": "ReplyOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parts"],
  "properties": {
    "schemaVersion": {
	  "type": "string",
      "const": "reply_output.v2"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskKeys", "content", "evidenceRefs", "actionRefs"],
        "properties": {
          "taskKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[KST][1-9][0-9]*$"
            }
          },
          "actionRefs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}

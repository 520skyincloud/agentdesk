{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/task_source_bindings.v1.json",
  "title": "TaskSourceBindingsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "primaryMessageId",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "task_source_bindings.v1"
    },
    "primaryMessageId": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "analysisRevision",
          "start",
          "end",
          "observationMessageIds"
        ],
        "properties": {
          "messageId": {
            "type": "integer",
            "minimum": 1
          },
          "analysisRevision": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "observationMessageIds": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/answer_requirement_set.v1.json",
  "title": "AnswerRequirementSetV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskKey", "requirements"],
  "properties": {
    "schemaVersion": {"const": "answer_requirement_set.v1"},
    "taskKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "sourceMessageId", "spanStart", "spanEnd", "required", "sequence"],
        "properties": {
          "key": {"type": "string", "pattern": "^R[1-9][0-9]*$", "maxLength": 16},
          "kind": {"type": "string", "minLength": 1, "maxLength": 80},
          "sourceMessageId": {"type": "integer", "minimum": 1},
          "spanStart": {"type": "integer", "minimum": 0},
          "spanEnd": {"type": "integer", "minimum": 0},
          "required": {"type": "boolean"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 8}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/reply_output.v3.json",
  "title": "ReplyOutputV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "parts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reply_output.v3"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupKey",
          "taskKeys",
          "content"
        ],
        "properties": {
          "groupKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taskKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/validation_result.v1.json",
  "title": "ValidationResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "normalizedParts",
    "checks",
    "errors",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "validation_result.v1"
    },
    "status": {
      "enum": ["passed", "rejected", "repairable_protocol_error"]
    },
    "normalizedParts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskKeys", "content", "evidenceRefs", "actionRefs"],
        "properties": {
          "taskKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[KST][1-9][0-9]*$"}
          },
          "actionRefs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "taskCoverage",
        "evidenceReferences",
        "actionReferences",
        "safety",
        "commitInvariants"
      ],
      "properties": {
        "schema": {"enum": ["passed", "failed"]},
        "taskCoverage": {"enum": ["passed", "failed"]},
        "evidenceReferences": {"enum": ["passed", "failed"]},
        "actionReferences": {"enum": ["passed", "failed"]},
        "safety": {"enum": ["passed", "failed"]},
        "commitInvariants": {"enum": ["passed", "failed"]}
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 80},
          "path": {"type": "string", "maxLength": 200},
          "message": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 80},
          "path": {"type": "string", "maxLength": 200},
          "message": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}

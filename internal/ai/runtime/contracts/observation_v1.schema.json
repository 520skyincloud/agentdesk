{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/observation.v1.json",
  "title": "ObservationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "sourceMessageId", "sourceRevision", "status", "sourceType", "observationType", "text", "confidence", "allowedUses", "forbiddenUses"],
  "properties": {
    "ref": {"type": "string", "pattern": "^O[1-9][0-9]*$"},
    "sourceMessageId": {"type": "integer", "minimum": 1},
    "sourceRevision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pending", "ready", "failed"]},
    "sourceType": {"enum": ["image", "voice", "video", "gif", "attachment", "text", "history"]},
    "observationType": {
      "enum": ["scene_description", "ocr_text", "document_text", "error_ui", "transcript", "audio_quality", "uncertain_span", "entity", "historical_statement"]
    },
    "text": {"type": "string", "maxLength": 4000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "allowedUses": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["describe_media", "resolve_reference", "build_knowledge_query", "quote_document"]}
    },
    "forbiddenUses": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["store_identity", "store_address", "store_phone", "store_policy", "resource_eligibility", "handoff_decision"]}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"properties": {"text": {"minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"text": {"maxLength": 0}}}}
  ]
}

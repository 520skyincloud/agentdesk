{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/generate_task_input.v2.json",
  "title": "GenerateTaskInputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "tasks"],
  "properties": {
    "schemaVersion": {"const": "generate_task_input.v2"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupRef", "groupKey", "sequence", "taskKeys", "outputMode", "required"],
        "properties": {
          "groupRef": {
            "type": "string",
            "pattern": "^G[1-9][0-9]*$",
            "maxLength": 8
          },
          "groupKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "taskKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "outputMode": {"const": "text"},
          "required": {"const": true}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskKey", "groupRef", "groupKey", "sequence", "customerRequest"],
        "properties": {
          "taskKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "groupRef": {
            "type": "string",
            "pattern": "^G[1-9][0-9]*$",
            "maxLength": 8
          },
          "groupKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "customerRequest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/validation_result.v2.json",
  "title": "ValidationResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "normalizedParts", "checks", "errors", "warnings"],
  "properties": {
    "schemaVersion": {"const": "validation_result.v2"},
    "status": {"enum": ["passed", "rejected", "repairable_protocol_error"]},
    "normalizedParts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskKeys", "content", "evidenceRefs", "actionRefs"],
        "properties": {
          "taskKeys": {
            "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "content": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidenceRefs": {
            "type": "array", "maxItems": 12, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[KSM][1-9][0-9]*$"}
          },
          "actionRefs": {
            "type": "array", "maxItems": 8, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "taskCoverage", "evidenceReferences", "factSourceBoundary",
        "knowledgeQuality", "resourceEligibility", "actionReferences", "safety", "commitInvariants"
      ],
      "properties": {
        "schema": {"enum": ["passed", "failed"]},
        "taskCoverage": {"enum": ["passed", "failed"]},
        "evidenceReferences": {"enum": ["passed", "failed"]},
        "factSourceBoundary": {"enum": ["passed", "failed"]},
        "knowledgeQuality": {"enum": ["passed", "failed"]},
        "resourceEligibility": {"enum": ["passed", "failed"]},
        "actionReferences": {"enum": ["passed", "failed"]},
        "safety": {"enum": ["passed", "failed"]},
        "commitInvariants": {"enum": ["passed", "failed"]}
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {
            "enum": [
              "schema_invalid", "task_coverage_incomplete", "unknown_evidence_ref",
              "evidence_task_mismatch", "missing_task_evidence", "unknown_action_ref",
              "action_not_prepared", "action_task_mismatch", "internal_term_exposed",
              "unsupported_action_claim", "action_not_committed_claim",
              "fact_ungrounded", "unsupported_domain_assertion",
              "protected_fact_source_violation", "customer_media_promoted_to_store_fact",
              "knowledge_quality_violation", "resource_eligibility_violation",
              "promise_outside_allowlist", "future_commit_claim",
              "turn_version_mismatch", "evidence_scope_missing",
              "too_many_reply_parts", "empty_reply_part"
            ]
          },
          "path": {"type": "string", "maxLength": 200},
          "message": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 80},
          "path": {"type": "string", "maxLength": 200},
          "message": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/question_unit.v1.json",
  "title": "QuestionUnitV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questionKey",
    "sequence",
    "primarySourceMessageId",
    "analysisRevision",
    "sourceRefs",
    "sourceSpans",
    "sourceSetFingerprint",
    "dependsOnObservationRefs",
    "intent",
    "subIntent",
    "requestMode",
    "text",
    "canonicalQuestionHash",
    "relation"
  ],
  "properties": {
    "questionKey": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "primarySourceMessageId": {
      "type": "integer",
      "minimum": 1
    },
    "analysisRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^U[1-9][0-9]*$"
      }
    },
    "sourceSpans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRef",
          "start",
          "end"
        ],
        "properties": {
          "sourceRef": {
            "type": "string",
            "pattern": "^U[1-9][0-9]*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "dependsOnObservationRefs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^O[1-9][0-9]*$"
      }
    },
    "sourceSetFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "subIntent": {
      "type": "string",
      "maxLength": 120
    },
    "requestMode": {
      "enum": [
        "answer",
        "request_action",
        "clarify_previous",
        "correct_previous",
        "confirm_previous",
        "cancel_previous",
        "social"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "canonicalQuestionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relation": {
      "enum": [
        "new_topic",
        "follow_up",
        "repeat",
        "refinement",
        "correction",
        "confirmation",
        "cancellation"
      ]
    }
  }
}
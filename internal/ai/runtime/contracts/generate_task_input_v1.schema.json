{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/generate_task_input.v1.json",
  "title": "GenerateTaskInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "generate_task_input.v1"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskKey",
          "sequence",
          "customerRequest",
          "answerGroupKey"
        ],
        "properties": {
          "taskKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "customerRequest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "answerGroupKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
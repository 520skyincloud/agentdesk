{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesk.local/schemas/intent_tasks.v2.json",
  "title": "IntentTasksV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dialogueAct", "tasks"],
  "properties": {
    "schemaVersion": {
      "const": "intent_tasks.v2"
    },
    "dialogueAct": {
      "enum": [
        "new_topic",
        "follow_up",
        "repeat",
        "correction",
        "confirmation",
        "cancellation",
        "greeting",
        "thanks",
        "closing",
        "unknown"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "intent",
          "subIntent",
          "text",
          "requestMode",
          "confidence"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "subIntent": {
            "type": "string",
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "requestMode": {
            "enum": [
              "answer",
              "request_action",
              "clarify_previous",
              "correct_previous",
              "confirm_previous",
              "cancel_previous",
              "social"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
